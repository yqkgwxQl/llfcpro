[GateServer]
Port = 8080
[VarifyServer]
Host = <地址>
Port = <端口>
[StatusServer]
Host = <地址>
Port = <端口>
[SelfServer]
Name = <服务器名称>
Host = 0.0.0.0
Port = <TCP端口>
RPCPort = <gRPC端口>
[PeerServer]
Servers = <对端服务器名称列表>
[chatserver]
Name = <服务器名称>
Host = <地址>
Port = <端口>
[Mysql]
Host = <地址>
Port = <端口>
User = <用户名>
Passwd = <密码>
Schema = <数据库名>
[Redis]
Host = <地址>
Port = <端口>
Passwd = <密码>
