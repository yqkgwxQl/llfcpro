/* 1. 滚动条的轨道（背景）*/
QScrollBar:vertical {
    background: transparent; /* 轨道背景透明，不遮挡内容 */
    width: 8px;              /* 将滚动条整体宽度限制为 8 像素（默认通常比较宽） */
    margin: 0px;             /* 清除默认的边距，让滚动条紧贴边缘 */
}
/* 2.滚动条的滑块（Handle）*/
QScrollBar::handle:vertical {
    background: rgb(173,170,169); /* 滑块颜色设置为浅灰色 */
    min-height: 10px;             /* 滑块的最小高度（防止内容极少时滑块缩成一个点） */
    border-radius: 4px;           /* 设置 4px 的圆角（宽度是 8px，一半正好是 4px，形成完美的胶囊/椭圆形状） */
}
/* 3.隐藏上下箭头按钮*/
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;       /* 将高度设为 0，彻底隐藏 */
    border: none;      /* 移除边框 */
    background: transparent; /* 背景透明 */
}
/* 4.隐藏点击轨道产生的背景色*/
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;  /* 清除轨道上下区域的背景 */
}
/*QScrollBar::sub-page:vertical：代表垂直滚动条中，滑块上方的空白轨道区域。
QScrollBar::add-page:vertical：代表垂直滚动条中，滑块下方的空白轨道区域
这两个区域不仅仅是视觉上的背景，它们还承担着交互功能。当你用鼠标点击滑块上方或下方的这些空白区域时，列表或文本框会向上或向下翻页滚动*/

